+# UIUC: expose the user-installed SDK before loading nvhpc/25.5.
+# Environment assignments in toolchain/modules are applied after module load.
+if [ "$u_c" == "uiuc" ] && [ "$cg" == "gpu" ]; then
+    module purge > /dev/null 2>&1 || return 1
+    export NVHPC_ROOT="${NVHPC_ROOT:-$HOME/opt/nvidia/hpc_sdk/Linux_x86_64/25.5}"
+    module use "$NVHPC_ROOT/../../modulefiles" || return 1
+fi
+
 # Collect the module names a line at a time. __extract() concatenates every
